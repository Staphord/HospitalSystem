# ──────────────────────────────────────────────
# Hospital Flow — Microservices Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# Application
ENVIRONMENT=dev                          # dev | staging | prod
SECRET_KEY=change_me_to_a_random_secret  # Used for internal signing; 64+ chars
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8501  # Comma-separated CORS origins

# Database (Master DB — stores tenants, users, subscriptions, super admins)
MASTER_DB_URL=postgresql://postgres:nasr@localhost:5432/hospital-db

# PostgreSQL Admin (for creating new tenant databases)
# Must have CREATEDB privilege. Same as MASTER_DB_URL if the user has CREATEDB.
DB_ADMIN_URL=postgresql://postgres:nasr@localhost:5432/postgres

# Tenant database naming
# {tenant_id} will be replaced with the actual tenant ID (e.g., hosp-a1b2c3d4)
TENANT_DB_TEMPLATE=postgresql://postgres:nasr@localhost:5432/tenant_{tenant_id}

# Redis (session cache, rate limiting, token blacklist, tenant suspension blocklist, JWKS cache)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ (event bus between services)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# SMTP (transactional emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change_me_to_a_secure_smtp_password

# Keycloak (OIDC provider)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=hospital-realm
KEYCLOAK_CLIENT_ID=hospital-api
KEYCLOAK_CLIENT_SECRET=change_me_to_a_secure_client_secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_to_a_secure_admin_password
KEYCLOAK_ACCESS_TOKEN_LIFESPAN=300

# Realm superadmins authenticate against. Defaults to "master" if unset.
# Any environment that shares a Keycloak instance with another environment
# (e.g. staging sharing the same Keycloak as production) MUST override this
# to a realm unique to that environment — e.g. master-staging — otherwise
# superadmin identity isn't isolated between them even though every other
# realm already is. Production can leave this unset (defaults to "master")
# or set it explicitly to "master" for clarity.
KEYCLOAK_MASTER_REALM=master

# When true, every API call introspects the token with Keycloak.
# Use in prod to instantly revoke access when a user is disabled.
# In dev you can set to false to reduce Keycloak load.
KEYCLOAK_INTROSPECT=true

# Multi-tenant
DEFAULT_HOSPITAL_ID=default-hospital

# Tenant DB encryption key (32-byte base64-encoded key for Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_DB_ENCRYPTION_KEY=ZXlKcGMzUWlPaUprYVhOamRXVnpZM0psY3lJc0luTjFZaUk2SWpFaUxDSnVZVzFsSWpvaU1EQWlMQ0pqYldGMFpXNTBYM1I1Y0dVaU9pSXhNREFpTENKemVtRnRaU0k2SWpFd01D

# Impersonation token TTL (seconds, default 15 minutes)
IMPERSONATION_TOKEN_TTL=900

# Suspension check interval (seconds, default 24 hours)
SUSPENSION_CHECK_INTERVAL=86400

# Suspended tenant blocklist TTL (seconds, default 1 hour)
SUSPENDED_BLOCKLIST_TTL=3600

# ──────────────────────────────────────────────
# Service URLs (used by API Gateway and inter-service calls)
# ──────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:8001
MASTER_SERVICE_URL=http://localhost:8002
RECEPTION_SERVICE_URL=http://localhost:8010
TRIAGE_SERVICE_URL=http://localhost:8011
CONSULTATION_SERVICE_URL=http://localhost:8012
LABORATORY_SERVICE_URL=http://localhost:8013
RADIOLOGY_SERVICE_URL=http://localhost:8014
PHARMACY_SERVICE_URL=http://localhost:8015
BILLING_SERVICE_URL=http://localhost:8016
WARD_SERVICE_URL=http://localhost:8017
ADMIN_SERVICE_URL=http://localhost:8018
NOTIFICATION_SERVICE_URL=http://localhost:8019
REPORT_SERVICE_URL=http://localhost:8020
CDS_SERVICE_URL=http://localhost:8021

# Password reset token expiry (seconds)
PASSWORD_RESET_TOKEN_TTL=3600

# Initial platform superadmin. These settings are the sole identity bootstrap
# source for Keycloak's master realm and the master database.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=superadmin123
SUPERADMIN_FULL_NAME=System Super Administrator




# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email@gmail.com
SMTP_PASSWORD=
SMTP_FROM=email@gmail.com
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────
# Hospital Assistant
# ──────────────────────────────────────────────
# Every capability is gated independently and ships disabled. Turn one on only
# after its phase has passed its exit gate. These flags are the kill switch and
# are evaluated before any subscription-module or role check.
ASSISTANT_OPERATIONAL_CHAT_ENABLED=false
ASSISTANT_VOICE_ENABLED=false
ASSISTANT_MEDICATION_CHECK_ENABLED=false
ASSISTANT_DIFFERENTIAL_SUPPORT_ENABLED=false
ASSISTANT_REALTIME_VOICE_ENABLED=false

# Model provider. Groq is the approved vendor. The key is read server-side only
# and is never returned to a browser, written to a log, or placed in an audit
# record. Leave it empty here; supply it through the deployment secret store.
# GROQ_MODEL was confirmed against the live Groq catalogue on 2026-08-26.
# llama-3.3-70b-versatile was retired and is no longer served; the agentic
# groq/compound models are excluded because they perform server-side web
# search and code execution, which the assistant must never reach.
ASSISTANT_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
ASSISTANT_REQUEST_TIMEOUT_SECONDS=20
ASSISTANT_MAX_QUESTION_CHARS=2000

# Push-to-talk voice. ASSISTANT_VOICE_ENABLED above is the kill switch and is
# off by default. whisper-large-v3 is used rather than the turbo variant because
# Swahili and code-mixed Swahili/English speech are required, and turbo trades
# multilingual accuracy for speed. Confirmed present in the account catalogue on
# 2026-08-27.
#
# Raw audio is never stored. There is deliberately no retention setting here:
# enabling retention would need an approved policy and its own code path.
#
# The timeout must stay below the API gateway's fixed 30 second proxy timeout,
# or a slow transcription surfaces as a gateway error rather than the
# assistant's own safe refusal.
ASSISTANT_TRANSCRIPTION_MODEL=whisper-large-v3
ASSISTANT_MAX_AUDIO_BYTES=5242880
ASSISTANT_MAX_AUDIO_DURATION_MS=60000
ASSISTANT_VOICE_TIMEOUT_SECONDS=20

# ── Clinical decision support (Hospital Assistant phase 5) ──────────────────
#
# The CDS service is a separate FastAPI service on port 8021, routed by the API
# Gateway at /api/v1/cds. Both switches default to false: with nothing set,
# every CDS route answers 404 and no clinical code runs.
CDS_ENABLED=false
CDS_MEDICATION_CHECK_ENABLED=false
# Phase 7 owns differential support. The switch exists before the capability so
# it can never ship without a way to pull it.
CDS_DIFFERENTIAL_SUPPORT_ENABLED=false

# Interaction ruleset. "null" means no approved source is configured, which is
# the default and is fail-closed: every medication check returns needs_review
# and nothing is ever reported as safe or as "no interaction found".
#
# No ruleset ships with this repository. Deciding whether two medicines
# interact, and how severely, is a clinical judgement that must come from a
# licensed or hospital-approved source signed off by a named pharmacist. To
# enable real checking, set CDS_RULESET_SOURCE=file and point CDS_RULESET_PATH
# at an approved, versioned artifact; the loader validates its metadata, its
# approval block, and its effective and review dates, and refuses an artifact
# that is not approved for the running environment.
CDS_RULESET_SOURCE=null
CDS_RULESET_PATH=
# A ruleset past its review date, or older than this many days without a fresh
# review, is treated as stale. A stale ruleset never concludes.
CDS_RULESET_STALE_AFTER_DAYS=180

CDS_MAX_MEDICATIONS_PER_CHECK=30
CDS_MAX_OVERRIDE_REASON_CHARS=500
