ENVIRONMENT=test
DATABASE_URL=postgresql://user:pass@localhost:5432/hospital_master
SECRET_KEY=change-me
REDIS_URL=redis://localhost:6379/0
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=hospital
KEYCLOAK_CLIENT_ID=hospital-backend
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_INTROSPECT=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501
DEFAULT_HOSPITAL_ID=default-hospital
TENANT_DB_ENCRYPTION_KEY=change-me
IMPERSONATION_TOKEN_TTL=900
SUSPENSION_CHECK_INTERVAL=86400
SUSPENDED_BLOCKLIST_TTL=3600
AUDIT_DATABASE_URL=
READONLY_SCOPE_ENFORCEMENT=log

# Clinical decision support kill switches. Both default to false: with nothing
# set, every /api/v1/cds route answers 404 and no clinical code runs.
CDS_ENABLED=false
CDS_MEDICATION_CHECK_ENABLED=false
# Phase 7 owns differential support. The switch exists before the capability so
# it can never ship without a way to pull it.
CDS_DIFFERENTIAL_SUPPORT_ENABLED=false

# Interaction ruleset. "null" means no approved source is configured, which is
# the default and is fail-closed: every check returns needs_review and nothing
# is ever reported as safe. Set CDS_RULESET_SOURCE=file and point
# CDS_RULESET_PATH at an approved, versioned artifact to enable real checking.
# No ruleset ships with this repository; interaction rules must come from a
# licensed or hospital-approved source signed off by a named pharmacist.
CDS_RULESET_SOURCE=null
CDS_RULESET_PATH=
# A ruleset older than this without a fresh review is treated as stale, and a
# stale ruleset never concludes.
CDS_RULESET_STALE_AFTER_DAYS=180

CDS_MAX_MEDICATIONS_PER_CHECK=30
CDS_MAX_OVERRIDE_REASON_CHARS=500
