# Template consumed by 04-generate-env-and-systemd.sh, which sed-replaces the
# __PLACEHOLDER__ tokens below with real values (SECRET_KEY and
# TENANT_DB_ENCRYPTION_KEY are generated fresh by that script; the rest come
# from environment variables you export before running it — see deploy/README.md).
# Do not hand-edit the __TOKENS__ — edit the generator invocation instead.
# NOTE: this becomes a systemd EnvironmentFile, which does NOT expand $VARS,
# so every value below must already be a fully literal string.

ENVIRONMENT=prod
ALLOWED_ORIGINS=http://__VPS_IP__

# --- Postgres (password generated by 01-setup-databases.sh) ---
MASTER_DB_URL=postgresql://postgres:__PG_PASSWORD__@127.0.0.1:5432/hospital_master
DATABASE_URL=postgresql://postgres:__PG_PASSWORD__@127.0.0.1:5432/hospital_master
DB_ADMIN_URL=postgresql://postgres:__PG_PASSWORD__@127.0.0.1:5432/postgres
TENANT_DB_TEMPLATE=postgresql://postgres:__PG_PASSWORD__@127.0.0.1:5432/tenant_{tenant_id}

# --- Redis / RabbitMQ ---
REDIS_URL=redis://127.0.0.1:6379/0
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# --- Keycloak (matches keycloak/realm-export.json as checked into the repo) ---
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=hospital-realm
KEYCLOAK_CLIENT_ID=hospital-api
KEYCLOAK_CLIENT_SECRET=hospital-api-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=__KEYCLOAK_ADMIN_PASSWORD__
KEYCLOAK_INTROSPECT=false
# Realm superadmins authenticate against. Defaults to "master" if unset.
# Any environment sharing a Keycloak instance with another environment MUST
# override this to a realm unique to that environment (e.g. master-staging)
# so superadmin identity is isolated the same way every other realm is.
KEYCLOAK_MASTER_REALM=master

# --- Initial platform superadmin ---
# This is the sole bootstrap identity. deploy/05-migrate-and-seed.sh lets the
# operator confirm or change it, then writes the result back to common.env.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=superadmin123
SUPERADMIN_FULL_NAME=System Super Administrator

# --- Multi-tenancy ---
DEFAULT_HOSPITAL_ID=default-hospital

# --- Filled in automatically by 04-generate-env-and-systemd.sh ---
SECRET_KEY=__SECRET_KEY__
TENANT_DB_ENCRYPTION_KEY=__TENANT_DB_ENCRYPTION_KEY__

IMPERSONATION_TOKEN_TTL=900
SUSPENSION_CHECK_INTERVAL=86400
SUSPENDED_BLOCKLIST_TTL=3600
PASSWORD_RESET_TOKEN_TTL=3600

# --- SMTP (transactional email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Admin-service backups ---
BACKUP_ROOT=/var/backups/hospital
BACKUP_RETENTION_DAYS=30
BACKUP_CHECK_INTERVAL=21600

# --- Hospital Assistant (report-service) ---
# One switch. Off, the assistant is absent rather than forbidden: no launcher is
# drawn in the browser, every assistant route answers 404, and no tenant
# connection is opened for it. On, all of it works - chat, history, the
# medicines reference, push-to-talk voice and live operational figures - and who
# reaches which part is decided by role, not here.
#
# It is filled in by 04-generate-env-and-systemd.sh from whether a GROQ_API_KEY
# was supplied, because an assistant with no key is worse than no assistant:
# staff get a button that fails on every question.
#
# Chat history needs tenant migration 0028, which the tenant provisioning flow
# applies with the rest.
ASSISTANT_OPERATIONAL_CHAT_ENABLED=__ASSISTANT_ENABLED__

# Whether a medicine the reference pack does not carry may be answered from the
# model's own general knowledge of pharmacology. The answer opens with a banner
# saying it is not from the hospital reference and that its figures have not
# been verified, and the audit row records it as needing review - but no server
# check can stand behind it, because there is no reference text to check it
# against. Off by default.
#
# The only assistant tuning still set here, deliberately: its safe value is a
# clinical judgement about the pack, so it belongs where the change is reviewed
# rather than somewhere it can be flipped from a browser.
#
# Note that switching the assistant on now also puts the medicines reference in
# front of doctors and pharmacists - it no longer has a flag of its own. Do not
# turn the assistant on for real patients until the hospital's pharmacist has
# read shared/medicines/pack.py against the national guidelines and signed it
# off. The pack is in use by the pharmacy dispensing gate either way; what the
# assistant adds is answering questions about it in words.
ASSISTANT_MEDICINES_MODEL_FALLBACK_ENABLED=false

# Model provider - bootstrap only.
#
# The key, the model, the timeouts and every request limit are now set by the
# platform super admin at /master/ai-assistant and stored in the master
# database, with the key encrypted under TENANT_DB_ENCRYPTION_KEY. Changing a
# model or rotating a key no longer needs a deploy or a restart.
#
# The three below seed that configuration the first time report-service starts
# against a database that has no row yet. The key is not a literal in this file:
# it is passed to 04-generate-env-and-systemd.sh and lands only in common.env,
# mode 640 and owned by the service user. The agentic groq/compound models are
# deliberately not offered anywhere - they perform server-side web search and
# code execution, which the assistant must never reach - and the portal refuses
# any model outside its allowlist.
GROQ_API_KEY=__GROQ_API_KEY__
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# --- Inter-service URLs (all loopback, ports match infrastructure/docker-compose.yml) ---
API_GATEWAY_URL=http://127.0.0.1:8000
AUTH_SERVICE_URL=http://127.0.0.1:8001
MASTER_SERVICE_URL=http://127.0.0.1:8002
PATIENT_SERVICE_URL=http://127.0.0.1:8005
VISIT_SERVICE_URL=http://127.0.0.1:8006
RECEPTION_SERVICE_URL=http://127.0.0.1:8010
TRIAGE_SERVICE_URL=http://127.0.0.1:8011
CONSULTATION_SERVICE_URL=http://127.0.0.1:8012
LABORATORY_SERVICE_URL=http://127.0.0.1:8013
RADIOLOGY_SERVICE_URL=http://127.0.0.1:8014
PHARMACY_SERVICE_URL=http://127.0.0.1:8015
BILLING_SERVICE_URL=http://127.0.0.1:8016
WARD_SERVICE_URL=http://127.0.0.1:8017
ADMIN_SERVICE_URL=http://127.0.0.1:8018
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8019
REPORT_SERVICE_URL=http://127.0.0.1:8020
